    {
      "requirement_id": "CODE.5.file-layout",
      "parent_rule_id": "CODE.5",
      "source": "rules/code/code-5-one-responsibility.md",
      "statement": "Added or changed C# declarations follow the approved file/type layout.",
      "verification_method": [
        "static-analysis"
      ],
      "automation_status": "implemented",
      "automation_tool": [
        {
          "name": "CheckTypes",
          "path": "tools/code/CheckTypes.csproj",
          "report_schema": 2
        }
      ],
      "coverage": {
        "scope": "C# declarations against a pinned baseline and explicit supported configurations",
        "exclusions": [
          "Generated files",
          "Private nested helpers"
        ],
        "residual": [
          "Cohesive responsibility",
          "Private-helper single-user ownership",
          "Other languages"
        ]
      },
      "owner": "team:teamvalue-aicoe"
    },
